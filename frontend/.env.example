# ──────────────────────────── core (required) ────────────────────────────
# Module-load fails immediately if either of these is missing —
# see frontend/src/supabaseClient.js.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ──────────────────────────── optional ───────────────────────────────────
# Used by the landing page CTA. Has a hardcoded fallback in
# components/landing/NavHero.jsx, so the build still works without it.
VITE_PATREON_URL=https://www.patreon.com/simualpha
