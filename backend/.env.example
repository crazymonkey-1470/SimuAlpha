# ──────────────────────────── core (required) ────────────────────────────
# Without these the backend either won't boot or will silently misbehave.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SCRAPER_URL=http://tli-scraper.railway.internal:8000

# ──────────────────────────── auth ───────────────────────────────────────
# Bearer token expected on /api/admin/* and a few agent-bridge routes.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# ──────────────────────────── LLM ────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ──────────────────────────── notification surfaces ──────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X (Twitter) v1.1 OAuth — required by services/x_poster.js. Without these
# every X post call will fail silently with an auth error.
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ──────────────────────────── data sources ───────────────────────────────
QUIVERQUANT_API_KEY=
FRED_API_KEY=
PERPLEXITY_API_KEY=
EXA_API_KEY=
AIRTABLE_API_KEY=

# ──────────────────────────── ops ────────────────────────────────────────
PORT=3000
